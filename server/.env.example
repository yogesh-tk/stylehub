PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/stylehub
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret

# Email OTP (Gmail App Password or SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=STYLEHUB <your-email@gmail.com>

# SMS OTP (Twilio - optional if using email OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1234567890

# Shipway Experience (legacy tracking API shown in your dashboard documentation)
SHIPWAY_USERNAME=your_registered_shipway_email
SHIPWAY_LICENSE_KEY=your_shipway_license_key
SHIPWAY_API_URL=https://shipway.in/api
SHIPWAY_PUSH_ORDERS_PATH=PushOrderData
SHIPWAY_TRACKING_PATH=getOrderShipmentDetails
SHIPWAY_CARRIERS_PATH=carriers
SHIPWAY_COMPANY_NAME=STYLEHUB
# Optional only if you configure the same custom header in Shipway webhooks
SHIPWAY_WEBHOOK_SECRET=
